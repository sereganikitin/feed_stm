# ─── Обязательно ───
PUBLIC_BASE_URL=https://feeds.infoseledka.ru # домен, под которым доступен сервер. Подставляется в URL внутри XML.

# ─── Авито (вариант A: native-выгрузка ProfitBase в формате Avito + подмена обложки) ───
# Получить в кабинете ProfitBase: выгрузки → формат Avito → URL вида export/avito/<token>.
# Если пусто — Авито-фид собирается конвертацией из ЦИАН-фида (вариант B, fallback).
PB_AVITO_FEED_URL_ZORGE9=
PB_AVITO_FEED_URL_B37=
# Опционально (используется только в варианте B / для доп.полей):
AVITO_HOUSE_TYPE_ZORGE9=                      # материал дома: Монолитный / Кирпичный / ...
AVITO_HOUSE_TYPE_B37=
AVITO_ND_ID_ZORGE9=                           # id ЖК в Авито (NewDevelopmentId), если есть
AVITO_ND_ID_B37=

# ─── HTTP-сервер (если запускать встроенным waitress) ───
SERVE_HOST=0.0.0.0
SERVE_PORT=8765
REFRESH_INTERVAL_HOURS=4                      # период авто-обновления фидов

# ─── Опционально: ProfitBase upload (если у них есть API для приёма XML) ───
PB_API_TOKEN=
PB_UPLOAD_URL=

# ─── Админ-панель /admin (для коллег) ───
ADMIN_PASSWORD=                              # общий пароль входа в панель
FLASK_SECRET_KEY=                            # длинная случайная строка для подписи cookie-сессий
